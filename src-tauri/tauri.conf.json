{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elyvon Studio",
  "mainBinaryName": "elyvon-studio",
  "version": "0.1.0",
  "identifier": "com.elyvon.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elyvon Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0E0F12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "publisher": "Elyvon",
    "copyright": "© 2026 Elyvon. All rights reserved.",
    "category": "Music",
    "shortDescription": "Digital audio workstation",
    "longDescription": "Elyvon Studio is a professional digital audio workstation by Elyvon.",
    "homepage": "https://github.com/atorcam102/Elyvon",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "section": "sound"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "UNCONFIGURED",
      "endpoints": [
        "https://github.com/atorcam102/Elyvon/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
